{
  "name": "Citi Bike Rebalancing (dark)",
  "dataColors": ["#3987e5", "#d95926", "#199e70", "#c98500", "#d55181", "#008300", "#9085e9", "#e66767"],
  "background": "#1a1a19",
  "secondaryBackground": "#262624",
  "foreground": "#f0efec",
  "foregroundNeutralSecondary": "#c3c2b7",
  "foregroundNeutralTertiary": "#898781",
  "backgroundLight": "#2c2c2a",
  "backgroundNeutral": "#383835",
  "tableAccent": "#3987e5",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#86b6ef",
  "center": "#256abf",
  "minimum": "#0d366b",
  "textClasses": {
    "callout":  { "fontFace": "Segoe UI Semibold", "fontSize": 30, "color": "#f0efec" },
    "title":    { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#f0efec" },
    "header":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#f0efec" },
    "label":    { "fontFace": "Segoe UI", "fontSize": 10, "color": "#c3c2b7" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#1a1a19" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2c2c2a" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#f0efec" } }, "fontSize": 12 }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#898781" } }, "gridlineColor": { "solid": { "color": "#2c2c2a" } } }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#898781" } }, "gridlineColor": { "solid": { "color": "#2c2c2a" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#c3c2b7" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0d0d0d" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#0d0d0d" } }, "transparency": 0 }]
      }
    }
  }
}
